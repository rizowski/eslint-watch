{
  "name": "eslint-watch",
  "version": "8.0.0",
  "description": "Run eslint with watch mode",
  "main": "./src",
  "scripts": {
    "ci:win": "npm run lint && npm test",
    "ci:test": "npm run lint && npm run test",
    "clean": "rm -rf build node_modules",
    "coverage": "vitest run --coverage",
    "deploy": "./scripts/deploy.sh",
    "prepare": "lefthook install",
    "lint:watch": "node ./bin/esw -w",
    "lint": "node ./bin/esw",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "engines": {
    "node": "^18.18.0 || ~20.19.0 || >=21.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rizowski/eslint-watch.git"
  },
  "bin": {
    "esw": "./bin/esw"
  },
  "files": [
    "bin",
    "src",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "plugin",
    "command line tool",
    "watch",
    "javascript",
    "linter",
    "cli"
  ],
  "author": {
    "name": "Colten Rouska",
    "email": "c.rouska@gmail.com"
  },
  "license": "MIT",
  "lint-staged": {
    "*.js": [
      "npm run lint -- --fix",
      "prettier --write --print-width=160"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write --print-width=80"
    ]
  },
  "bugs": {
    "url": "https://github.com/rizowski/eslint-watch/issues"
  },
  "homepage": "https://github.com/rizowski/eslint-watch",
  "peerDependencies": {
    "eslint": ">=9 <10.0.0"
  },
  "dependencies": {
    "chokidar": "~4.0.0",
    "debug": "^4.4.3",
    "execa": "^5.1.1",
    "keypress": "^0.2.1",
    "lodash.debounce": "^4.0.8",
    "lodash.isempty": "^4.4.0",
    "lodash.isequal": "^4.5.0",
    "lodash.kebabcase": "^4.1.1",
    "lodash.unionwith": "^4.6.0",
    "optionator": "^0.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@evilmartians/lefthook": "^1.11.6",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^11.2.6",
    "prettier": "^3.8.1",
    "vitest": "^3.0.0"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
